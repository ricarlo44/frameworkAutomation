# teststore.blassacademy.com under test. No real secrets: these are the
# publicly published demo credentials shown on the site's own login page.
STORE_URL=https://teststore.blassacademy.com
STANDARD_USER=standard_user
BLOCKED_USER=blocked_user
TIMEOUT_USER=timeout_user
STORE_PASSWORD=secret_blass_academy

# Public practice API used for the API-testing suite (the store itself has
# no backend — see README "Why dummyjson.com" section). reqres.in was tried
# first but its anonymous tier caps at 40 requests/day, which broke on the
# very first CI run.
API_BASE_URL=https://dummyjson.com
